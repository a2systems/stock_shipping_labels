<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_shipping_labels" model="report.paperformat">
        <field name="name">Etiquetas de Envío A4 4-up</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_shipping_labels" model="ir.actions.report">
        <field name="name">Etiquetas de Envío</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_shipping_labels.report_shipping_labels_document</field>
        <field name="report_file">stock_shipping_labels.report_shipping_labels_document</field>
        <field name="print_report_name">'Etiquetas - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_shipping_labels"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
